//App Description

//The system scans a QR code and extracts its ID.
//The ID is then validated against the database.
//If a matching record is found, the associated data is retrieved and displayed.
//If the ID is invalid or does not match any record, a compatibility error is shown.
//If a network or service issue occurs, an internet error message is displayed.


using UnityEngine;
using UnityEngine.UI;
using TMPro;
using ZXing;                 // Library used to read QR Codes
using Firebase;
using Firebase.Firestore;    // Firestore database
using Firebase.Extensions;   // Allows Firebase callbacks on the main thread
using Firebase.Auth;         // Firebase authentication
using System;
using System.Collections;
using UnityEngine.Android;   // Android permissions (Camera)
using System.Collections.Generic;

public class QRScannerController : MonoBehaviour
{
    [Header("UI References")]
    [SerializeField] private RawImage _rawImageBackground;
    // Displays the live camera feed on the UI

    [SerializeField] private AspectRatioFitter _aspectRatioFitter;
    // Keeps the camera image aspect ratio correct

    [SerializeField] private TextMeshProUGUI _textOut;
    // Shows status messages and scan results

    [SerializeField] private RectTransform _scanZone;
    // Scan area (reserved for future use / visual guide)

    [SerializeField] private Button _btnResumeScan;
    // Button to manually resume scanning

    private bool _isCamAvaible = false;
    // Indicates whether the camera is ready

    private bool _canScan = true;
    // Controls whether scanning is allowed

    private WebCamTexture _cameraTexture;
    // Camera texture used to capture frames

    private FirebaseFirestore db;
    // Reference to Firestore database

    private Coroutine _scanTimeout;
    // Coroutine used to handle scan timeout

    void Start()
    {
        // Initialize Firebase services
        InitFirebase();

        // Assign button click event
        _btnResumeScan.onClick.AddListener(ResumeScanManual);

        // Hide resume button at start
        _btnResumeScan.gameObject.SetActive(false);

        // Start checking camera permission
        StartCoroutine(CameraPermissionLoop());
    }

    private IEnumerator CameraPermissionLoop()
    {
#if UNITY_ANDROID
        // Keep requesting camera permission until granted
        while (!Permission.HasUserAuthorizedPermission(Permission.Camera))
        {
            _textOut.text = "Camera permission is required";
            Permission.RequestUserPermission(Permission.Camera);
            yield return new WaitForSeconds(1f);
        }
#endif
        // Once permission is granted, set up the camera
        yield return StartCoroutine(SetUpCamera());
    }

    void OnApplicationFocus(bool hasFocus)
    {
        // Called when the app regains focus
        if (!hasFocus) return;

        // Recheck camera if it was not available
        if (!_isCamAvaible)
        {
            StartCoroutine(CameraPermissionLoop());
        }
    }

    private IEnumerator SetUpCamera()
    {
        // Stop and destroy previous camera instance if it exists
        if (_cameraTexture != null)
        {
            _cameraTexture.Stop();
            Destroy(_cameraTexture);
        }

        // Get all available cameras
        WebCamDevice[] devices = WebCamTexture.devices;

        // No camera found
        if (devices.Length == 0)
        {
            _textOut.text = "No camera found";
            yield break;
        }

        // Select the back camera
        foreach (var device in devices)
        {
            if (!device.isFrontFacing)
            {
                _cameraTexture = new WebCamTexture(device.name);
                break;
            }
        }

        // Start the camera
        _cameraTexture.Play();

        // Wait until camera is fully initialized
        while (_cameraTexture.width <= 16)
            yield return null;

        // Assign camera feed to UI
        _rawImageBackground.texture = _cameraTexture;
        _isCamAvaible = true;
        _textOut.text = "Camera Ready";
    }

    void Update()
    {
        // Exit if camera is not ready
        if (!_isCamAvaible || _cameraTexture == null || !_cameraTexture.isPlaying)
            return;

        // Adjust aspect ratio based on camera resolution
        float ratio = (float)_cameraTexture.width / _cameraTexture.height;
        _aspectRatioFitter.aspectRatio = ratio;

        // Rotate image based on device orientation
        int rotation = _cameraTexture.videoRotationAngle;
        _rawImageBackground.rectTransform.localEulerAngles =
            new Vector3(0, 0, -rotation);

        // Fix vertical mirroring
        float scaleY = _cameraTexture.videoVerticallyMirrored ? -1f : 1f;
        _rawImageBackground.rectTransform.localScale =
            new Vector3(1f, scaleY, 1f);

        // Perform scan if allowed
        if (_canScan)
            Scan();
    }

    private void Scan()
    {
        try
        {
            // Create QR code reader
            IBarcodeReader reader = new BarcodeReader();

            // Decode QR code from camera frame
            Result result = reader.Decode(
                _cameraTexture.GetPixels32(),
                _cameraTexture.width,
                _cameraTexture.height
            );

            // No QR detected
            if (result == null) return;

            // Stop further scanning
            _canScan = false;

            // Vibrate device for feedback
            Handheld.Vibrate();

            string qrId = result.Text.Trim();

            // Validate QR prefix
            if (string.IsNullOrEmpty(qrId) || !qrId.StartsWith("qr_entrance_"))
            {
                _textOut.text = "Invalid QR Code";
                _canScan = false;
                ShowResumeButton();
                return;
            }

            // Show searching status
            _textOut.text = "Searching...";

            // Start timeout (5 seconds)
            if (_scanTimeout != null) StopCoroutine(_scanTimeout);
            _scanTimeout = StartCoroutine(ScanTimeout());

            // Fetch data from Firestore
            FetchData(qrId);
        }
        catch (Exception e)
        {
            // Handle unexpected errors
            Debug.LogWarning("QR Scan Exception: " + e.Message);
            _textOut.text = "Scan Error";
            ShowResumeButton();
        }
    }

    private IEnumerator ScanTimeout()
    {
        // Wait for 5 seconds
        yield return new WaitForSeconds(5f);

        // If still not resolved, show error
        if (!_canScan)
        {
            _textOut.text = "Service unavailable, try again";
            ShowResumeButton();
        }
    }

    private void InitFirebase()
    {
        // Check Firebase dependencies
        FirebaseApp.CheckAndFixDependenciesAsync()
            .ContinueWithOnMainThread(task =>
            {
                if (task.Result == DependencyStatus.Available)
                {
                    // Initialize Firestore
                    db = FirebaseFirestore.DefaultInstance;

                    // Anonymous sign-in
                    FirebaseAuth.DefaultInstance.SignInAnonymouslyAsync();
                }
                else
                {
                    _textOut.text = "Firebase Init Failed";
                }
            });
    }

    private void FetchData(string qrId)
    {
        // Firebase not ready
        if (db == null)
        {
            _textOut.text = "Service not ready, try again";
            ShowResumeButton();
            return;
        }

        // Request QR document from Firestore
        db.Collection("qr_anchors").Document(qrId)
          .GetSnapshotAsync()
          .ContinueWithOnMainThread(task =>
          {
              // Stop timeout when response arrives
              if (_scanTimeout != null)
              {
                  StopCoroutine(_scanTimeout);
                  _scanTimeout = null;
              }

              // show resume button
              ShowResumeButton();

              // Network or request error
              if (task.IsFaulted)
              {
                  _textOut.text = "Network Error!";
                  return;
              }

              DocumentSnapshot snap = task.Result;

              if (snap.Exists)
              {
                  // Convert Firestore data to dictionary
                  var data = snap.ToDictionary();

                  // Read building and floor info
                  string building = data.ContainsKey("buildingId") ? data["buildingId"].ToString() : "Unknown";
                  int floor = data.ContainsKey("floor") ? Convert.ToInt32(data["floor"]) : 0;

                  float x = 0f;
                  float y = 0f;

                  // Read anchor position
                  if (data.ContainsKey("anchorPos"))
                  {
                      var anchorPos = data["anchorPos"] as IDictionary<string, object>;
                      if (anchorPos != null)
                      {
                          if (anchorPos.ContainsKey("x")) x = Convert.ToSingle(anchorPos["x"]);
                          if (anchorPos.ContainsKey("y")) y = Convert.ToSingle(anchorPos["y"]);
                      }
                  }

                  // Display result
                  _textOut.text =
                      $"Building: {building}\nFloor: {floor}\nanchorPos.x = {x}, anchorPos.y = {y})";
              }
              else
              {
                  _textOut.text = "QR code is not registered";
              }
          });
    }

    private void ShowResumeButton()
    {
        // Enable resume scan button
        _btnResumeScan.gameObject.SetActive(true);
    }

    public void ResumeScanManual()
    {
        // Allow scanning again
        _canScan = true;
        _textOut.text = "Ready to scan...";
        _btnResumeScan.gameObject.SetActive(false);
    }
}

