rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // admins collection
    match /admins/{userId} {
      allow read: if request.auth != null; // القراءة فقط للمستخدمين المسجلين
      allow write: if false;               // لا أحد يستطيع الكتابة
    }

    // POIs collection
    match /pois/{poiId} {
      allow read: if true; // القراءة للجميع
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
        // الكتابة فقط للمستخدمين المسجلين في admins
    }

    // qr_anchors collection (تمت الإضافة)
    match /qr_anchors/{qrId} {
      allow read: if true;   // السماح للـ Unity QR Scanner بالقراءة أثناء الاختبار
      allow write: if false; // لا يسمح بالكتابة من التطبيق
    }

  }
}

